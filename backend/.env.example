# AikSetra Example Configuration (Never use example secrets or passwords in deployment)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=replace_with_cryptographically_secure_32_character_jwt_secret
ADMIN_API_KEY=replace_with_cryptographically_secure_32_character_admin_key
WEBHOOK_SECRET=replace_with_cryptographically_secure_32_character_webhook_secret
ALLOWED_ORIGINS=https://aiksetra.in,https://app.aiksetra.in
DATA_DIR=./data
DEFAULT_VPA_HANDLE=@aiksetra

# PostgreSQL Database Configuration (Replace with your secure database credentials)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=replace_with_your_strong_database_password
PG_DATABASE=aiksetra_db
DATABASE_URL=postgresql://postgres:replace_with_your_strong_database_password@localhost:5432/aiksetra_db

# NPCI UPI PSP Switch Configuration
NPCI_PSP_GATEWAY=YESBANK_UPI20
NPCI_MERCHANT_KEY=
NPCI_MERCHANT_SECRET=
MOCK_PSP_DELAY_MS=200
MOCK_PSP_MODE=SUCCESS

# SMS Gateway Configuration (Use CONSOLE for local testing; or FAST2SMS/MSG91/TWILIO for cellular delivery)
SMS_GATEWAY_PROVIDER=CONSOLE
FAST2SMS_API_KEY=replace_with_your_fast2sms_api_key
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AIKSET
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Business & Regulatory Limits
ESCROW_AUTO_RELEASE_DAYS=7
LRS_ANNUAL_LIMIT_USD=250000
